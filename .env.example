# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Protected ingestion route
CRON_SECRET=

# GDELT (legacy DOC 2.0 API — kept as fallback)
GDELT_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_QUERY_LOCATION=Mumbai
GDELT_QUERY_DISEASES=Dengue,Malaria

# Google BigQuery (primary GDELT source)
# Set to your GCP project ID. Uses Application Default Credentials locally (gcloud auth application-default login).
GOOGLE_CLOUD_PROJECT=
